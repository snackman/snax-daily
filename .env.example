# --- AI (required to generate digests) -------------------------------------
# OpenAI API key used for ranking + summarization.
OPENAI_API_KEY=

# Optional: override the ranking/summarization model.
# Default: gpt-4o-mini
# DIGEST_MODEL=gpt-4o

# --- Scheduling / display ---------------------------------------------------
# Timezone used to stamp each digest's date. Default: America/New_York
# DIGEST_TZ=America/New_York

# --- Cron protection (recommended on Vercel) --------------------------------
# When set, /api/generate requires  Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends this automatically once configured.
CRON_SECRET=

# --- Owner PIN --------------------------------------------------------------
# When set, saving settings and syncing read/star state to the server require
# this PIN (sent as the x-settings-pin header). Visitors are local-only.
SETTINGS_PIN=

# --- Storage ----------------------------------------------------------------
# Set automatically when you add a Vercel Blob store to the project.
# When absent, digests are written locally to .data/digests/*.json
# BLOB_READ_WRITE_TOKEN=
